APP_NAME="Loan Analytic BPR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://loan-analytic-bpr.test
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_ENGINE_VERSION=calc-v1.0.0

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=loan_analytic_bpr
DB_USERNAME=your_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@bpr-bahteramas.local"
MAIL_FROM_NAME="${APP_NAME}"

LEDGER_CHAIN=true
IMPORT_MAX_ROWS=5000
IMPORT_MAX_FILE_MB=25
OCR_DRIVER=auto
OCR_LANG=ind
TESSERACT_PATH=
PII_STORAGE=encrypted
ADMIN_INITIAL_PASSWORD=
AUDITOR_INITIAL_PASSWORD=
PILOT_INITIAL_PASSWORD=
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_LENGTH_PRODUCTION=12
